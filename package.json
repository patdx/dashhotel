{
	"name": "patdx-remix-template",
	"private": true,
	"sideEffects": false,
	"type": "module",
	"scripts": {
		"build": "remix vite:build",
		"deploy": "wrangler pages deploy",
		"dev": "pnpm tsx dev.ts && remix vite:dev",
		"start": "wrangler pages dev",
		"typecheck": "tsc",
		"typegen": "wrangler types",
		"update-react": "pnpm install react@rc react-dom@rc && pnpm install --save-dev babel-plugin-react-compiler@experimental",
		"lint": "biome lint",
		"lint:fix": "biome lint --fix",
		"format": "biome format --write"
	},
	"dependencies": {
		"@libsql/client": "0.18.0",
		"@opentelemetry/otlp-transformer": "0.222.0",
		"@paralleldrive/cuid2": "2.3.1",
		"@radix-ui/react-label": "2.1.15",
		"@radix-ui/react-scroll-area": "1.2.18",
		"@radix-ui/react-select": "2.3.7",
		"@radix-ui/react-slot": "1.3.3",
		"@remix-run/node": "2.17.5",
		"@remix-run/react": "2.17.5",
		"@remix-run/serve": "2.17.5",
		"@types/lodash-es": "4.17.12",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"drizzle-orm": "0.45.2",
		"framer-motion": "11.18.2",
		"hono": "4.13.7",
		"isbot": "5.2.2",
		"lodash-es": "4.18.1",
		"lucide-react": "0.577.0",
		"mobx": "6.13.5",
		"mobx-react-lite": "4.0.7",
		"overlayscrollbars": "2.16.0",
		"overlayscrollbars-react": "0.5.6",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-resizable-panels": "2.1.9",
		"tailwind-merge": "2.6.1",
		"tailwindcss-animate": "1.0.7"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@cloudflare/workers-types": "4.20240821.1",
		"@remix-run/dev": "2.17.5",
		"@types/react": "npm:types-react@rc",
		"@types/react-dom": "npm:types-react-dom@rc",
		"autoprefixer": "10.5.5",
		"babel-plugin-react-compiler": "0.0.0-experimental-ff4e0fd-20260324",
		"drizzle-kit": "0.31.10",
		"postcss": "8.5.28",
		"tailwindcss": "3.4.19",
		"tsx": "4.23.13",
		"typescript": "5.9.3",
		"unplugin-auto-import": "0.19.0",
		"vite": "5.4.21",
		"vite-plugin-babel": "1.7.3",
		"vite-tsconfig-paths": "5.1.4",
		"wrangler": "3.72.2",
		"zx": "8.8.5"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [],
		"overrides": {
			"@types/react": "$@types/react",
			"@types/react-dom": "$@types/react-dom"
		}
	},
	"packageManager": "pnpm@9.15.9"
}
